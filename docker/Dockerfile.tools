# A tool environment only; this does NOT run any upstream agent or the control plane.
# Build requires internet access. Container execution is offline by runtime policy.
# Not built or executed in the delivery environment: validate on your own Docker host.
FROM python:3.13-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash ca-certificates build-essential file binutils gdb strace \
    openssl xxd jq unzip p7zip-full sqlite3 zstd libffi-dev libssl-dev \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install \
    'pwntools>=4.13,<5' 'pycryptodome>=3.20,<4' 'sympy>=1.13,<2' \
    'z3-solver>=4.13,<5' 'capstone>=5,<6' 'pyelftools>=0.31,<1' \
    'Pillow>=11,<13' 'numpy>=2,<3'
WORKDIR /work
CMD ["/bin/sh"]
